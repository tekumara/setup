# ghostty has nerd fonts built in, but use MesloLGS because it has less line spacing
# and its being used elsewhere
font-family = "MesloLGS NF"

theme = Catppuccin Mocha

# avoid prompting when nvim wants to read from the clipboard
# via OSC 52 sequences (ie: over ssh)
clipboard-read = allow

# move two lines at a time via the mouse scroll wheel
mouse-scroll-multiplier = 2.0
